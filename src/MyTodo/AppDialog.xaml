<Window x:Class="MyTodo.AppDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MyTodo" Width="420" SizeToContent="Height" MaxHeight="520"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" KeyDown="Window_KeyDown">
    <Border Margin="14" Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
            CornerRadius="{DynamicResource PlanCardCornerRadius}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.24" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="5" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Background="{DynamicResource AccentBrush}"
                    CornerRadius="{DynamicResource PlanCardCornerRadius}" />
            <Grid Grid.Row="1" Margin="22,17,14,0">
                <TextBlock x:Name="DialogTitle" FontSize="18" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                <Button HorizontalAlignment="Right" Width="32" Height="32" Padding="0"
                        Style="{StaticResource IconButton}" Content="&#xE8BB;"
                        ToolTip="关闭" Click="Cancel_Click" />
            </Grid>
            <ScrollViewer Grid.Row="2" MaxHeight="310" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="DialogMessage" Margin="22,15,22,18" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextBrush}" LineHeight="22" />
            </ScrollViewer>
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="22,0,22,20">
                <Button x:Name="CancelButton" Style="{StaticResource SoftButton}"
                        Content="取消" Margin="0,0,8,0" Click="Cancel_Click" />
                <Button x:Name="ConfirmButton" Style="{StaticResource PrimaryButton}"
                        Content="确定" Click="Confirm_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
